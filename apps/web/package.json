{
  "name": "@hymndesk/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "HymnDesk Web PWA — Vite + React (Phase 2 replacement for root index.html)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hymndesk/domain": "workspace:*",
    "@hymndesk/types": "workspace:*",
    "@hymndesk/design-tokens": "workspace:*",
    "@hymndesk/api-client": "workspace:*",
    "@hymndesk/auth": "workspace:*",
    "@hymndesk/sync": "workspace:*",
    "@hymndesk/search": "workspace:*",
    "@hymndesk/hymn-engine": "workspace:*",
    "@hymndesk/projection": "workspace:*"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
