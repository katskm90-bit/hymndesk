# HymnDesk environment configuration
# Copy this file to .env.local (never commit .env.local)
# Values here are examples only — no real credentials

# ── Supabase ──────────────────────────────────────────────────────────────────
# Public / anon key — safe to expose in client code
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Content distribution ──────────────────────────────────────────────────────
VITE_HYMNS_URL=https://hymndesk.co.za/hymns.json

# ── App environment ────────────────────────────────────────────────────────────
# development | staging | production
VITE_APP_ENV=development

# ── Sentry (optional, Phase 1+) ────────────────────────────────────────────────
# VITE_SENTRY_DSN=https://...@sentry.io/...

# ──────────────────────────────────────────────────────────────────────────────
# SERVER-SIDE ONLY (Edge Functions — never in client code)
# ──────────────────────────────────────────────────────────────────────────────
# SUPABASE_SERVICE_ROLE_KEY=  ← NEVER IN CLIENT CODE
# GITHUB_PAT=                 ← NEVER IN CLIENT CODE (Phase 1 security fix)
# PAYFAST_MERCHANT_ID=        ← NEVER IN CLIENT CODE (Phase 1 security fix)
# PAYFAST_MERCHANT_KEY=       ← NEVER IN CLIENT CODE (Phase 1 security fix)
